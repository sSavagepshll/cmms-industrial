NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://om_user:troque_esta_senha@localhost:5432/ordens_manutencao
CORS_ORIGIN=http://localhost:3000,https://localhost:3000,http://localhost:3800,https://localhost:3800
# Obrigatório, mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=5m
# true somente se a API estiver atrás de proxy confiável (necessário para o rate limit enxergar o IP real)
TRUST_PROXY=false
# HTTPS com certificado autoassinado (intranet). Defina os DOIS caminhos (PEM) e os arquivos devem existir; vazio = HTTP.
# Par do projeto: ./certs/key.pem e ./certs/cert.pem (no Docker: /certs/key.pem e /certs/cert.pem)
SSL_KEY_PATH=
SSL_CERT_PATH=
TZ_RELATORIOS=America/Sao_Paulo
RETROATIVO_MAX_DIAS=30
# Opcionais (e-mail): chave que criptografa segredos das configuracoes (min. 32 chars; vazio = deriva do JWT_SECRET),
# URL do front nos links dos e-mails, e exigencia de STARTTLS no SMTP.
CONFIG_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
SMTP_REQUIRE_TLS=true
# Fase 36: remetente e anexo PDF
EMAIL_REMETENTE_NOME=Apex Industrial Technologies · CMMS
OUTBOX_EMAIL_ANEXO_MAX_KB=200
# Fase 37 (RN-87): sessão do painel (GERENTE/ADMIN em /admin), em segundos. Absoluta, teto 43200 (12 h).
ADMIN_SESSAO_TTL_S=43200
# Sessao curta do TOTEM (login por PIN com Device ID): expira em KIOSK_TOKEN_TTL_S segundos ABSOLUTOS (padrao 900 = 15 min; faixa 60-1800), sem renovacao.
KIOSK_TOKEN_TTL_S=900
# Device IDs de totens autorizados (CSV). Vazio = qualquer ID e aceito. Ex.: TOTEM-01,TOTEM-02
TOTENS_AUTORIZADOS=
# Perfis que so podem entrar por um totem (login sem Device ID e recusado). Ex.: OPERADOR,LIDER_PRODUCAO
TOTEM_OBRIGATORIO_PERFIS=
