# URL da API vista pelo NAVEGADOR (CORS da API deve liberar a origem do web)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Identificador do totem/posto de origem (RN-01)
NEXT_PUBLIC_TOTEM_ID=TOTEM-01
# Atalhos "Técnico" / "Gestor / Admin" na tela de repouso do totem. Padrão: DESLIGADO (produção).
# Em desenvolvimento já vem ligado por .env.development; para ligar em outro ambiente: true.
NEXT_PUBLIC_ATALHOS_PAINEL=false
