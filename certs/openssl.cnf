[req]
default_bits        = 2048
prompt              = no
default_md          = sha256
distinguished_name  = dn
x509_extensions     = v3_req

[dn]
C  = BR
ST = SP
L  = Sao Paulo
O  = Apex Industrial Technologies
OU = Seguranca Cibernetica
CN = localhost

[v3_req]
basicConstraints     = CA:FALSE
keyUsage             = digitalSignature, keyEncipherment
extendedKeyUsage     = serverAuth, clientAuth
subjectAltName       = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = apex-kiosk.local
IP.1  = 127.0.0.1
