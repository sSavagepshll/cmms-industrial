# Copie para .env na raiz (nao versionar). Lido automaticamente pelo docker compose.
POSTGRES_USER=om_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=ordens_manutencao

WEB_PORT=3000
WEB_PORT_ALT=3800
API_PORT=4000
DB_PORT=5432

# OBRIGATORIO na API (min. 32 caracteres). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=5m

# CORS da API = origem do web. Suporta multiplas origens separadas por virgula.
# Exemplo TLS e portas 3000/3800:
CORS_ORIGIN=http://localhost:3000,https://localhost:3000,http://localhost:3800,https://localhost:3800
NEXT_PUBLIC_API_URL=https://localhost:4000
API_INTERNAL_URL=https://api:4000
NEXT_PUBLIC_TOTEM_ID=TOTEM-01

# Fase 32 (US-17): perfis que podem entrar no Totem (ADMIN e sempre incluido). Adicione GERENTE para liberar a gestao no Totem.
TOTEM_PERFIS_PERMITIDOS=OPERADOR,LIDER_PRODUCAO,ADMIN

# Fase 34/35: outbox transacional de e-mail (LISTEN/NOTIFY + polling); único caminho de e-mail (OUTBOX_EMAIL_ATIVO foi removida).
OUTBOX_EMAIL_MAX_TENTATIVAS=6
OUTBOX_EMAIL_LOTE=10
OUTBOX_EMAIL_LEASE_SEG=120
OUTBOX_EMAIL_POLL_SEG=30
OUTBOX_EMAIL_CONCORRENCIA=2
OUTBOX_EMAIL_SHUTDOWN_SEG=20
# Fase 35: PDF da ficha anexado nos e-mails de abertura e conclusão (gerado no worker com pdfkit).
FICHA_PDF_TIMEOUT_MS=10000
OUTBOX_EMAIL_ANEXO_MAX_KB=200
# Fase 36: nome de exibição do remetente (From). O endereço continua sendo o usuário SMTP.
EMAIL_REMETENTE_NOME=Apex Industrial Technologies · CMMS
# Fase 37 (RN-87): sessão do painel (GERENTE/ADMIN em /admin), em segundos. Absoluta, teto 43200 (12 h).
ADMIN_SESSAO_TTL_S=43200
# Conexão direta (sem PgBouncer em modo transaction) usada só pelo LISTEN; vazio = DATABASE_URL
DATABASE_URL_DIRECT=

# Caminhos de certificado SSL dentro dos containers
SSL_KEY_PATH=/certs/key.pem
SSL_CERT_PATH=/certs/cert.pem

# Carga demo do portfólio (defina false em produção)
SEED_PORTFOLIO=true
